#!/usr/bin/env bash
# initio - ferramenta oficial de ambiente.  initio ajuda
set -u
H="$HOME"
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
SELFDIR="$(dirname "$SELF")"
if [ -z "${INITIO_HOME:-}" ]; then
  # rodando de um pacote (ex.: B:\_consolidacao\initio) vale o pacote; rodando o instalado, vale ~/.local/share/initio
  if [ -d "$SELFDIR/perfis" ]; then INITIO_HOME="$SELFDIR"; else INITIO_HOME="$H/.local/share/initio"; fi
fi
STATE="$H/.local/state/initio"; mkdir -p "$STATE"
LOG="$H/initio.log"; DRY=0; UPGRADE=0; RES=()
PATH="$H/.local/bin:$H/.cargo/bin:$PATH"; export PATH
export DEBIAN_FRONTEND=noninteractive NEEDRESTART_MODE=a
SEGRE='(api[_-]?key|token|secret|passw(or)?d|bearer|ghp_|gho_|github_pat_|sk-[A-Za-z0-9]{16,}|AKIA[0-9A-Z]{12,}|AGE-SECRET-KEY|PRIVATE KEY)'
say() { echo "[$(date +%H:%M:%S)] $*"; }
ok()  { RES+=("OK     $1"); }
bad() { local m; m=$(tail -n 40 "$LOG" 2>/dev/null | grep -iE 'error|erro|fail|not found|could not|unable|denied|conflict' | tail -n 1 | cut -c1-150); RES+=("FALHOU $1${m:+  <- $m}"); }
S()   { sudo -n -E "$@"; }
age_d() { if { : </dev/tty; } 2>/dev/null; then age -d "$@" </dev/tty; else echo "sem terminal (/dev/tty): rode initio restore direto num terminal, nao via pipe" >&2; return 1; fi; }
czsrc() { chezmoi source-path 2>/dev/null || echo "$H/.local/share/chezmoi"; }
cofre_dir() { local d; [ "${INITIO_SEM_ONEDRIVE:-0}" = 1 ] && return 0; for d in /mnt/c/Users/*/OneDrive*/Documentos/Credenciais\ e\ Certificados/_cofre; do [ -d "$d" ] && { echo "$d"; return; }; done; }

# ================= base de sudo (uma senha, depois sozinho) =================
sudo_prep() {
  [ -n "${SUDO_OK:-}" ] && return; SUDO_OK=1
  { printf "\n>>> SENHA DO SUDO (digite e Enter; nao aparece na tela). Pedida so esta vez:\n" >/dev/tty; } 2>/dev/null || printf "\n>>> SENHA DO SUDO (digite e Enter; nao aparece na tela). Pedida so esta vez:\n"
  sudo -v || exit 1
  ( while true; do sudo -n true 2>/dev/null; sleep 50; kill -0 "$$" 2>/dev/null || exit; done ) & KEEP=$!
  # WSL: postinst de servicos (ex: openssh-server) falha ao iniciar servico; policy-rc.d=101 impede o dpkg de iniciar servicos
  if [ ! -e /usr/sbin/policy-rc.d ]; then printf '#!/bin/sh\nexit 101\n' | sudo -n tee /usr/sbin/policy-rc.d >/dev/null && sudo -n chmod +x /usr/sbin/policy-rc.d && MADE=1; fi
  trap '[ "${MADE:-0}" = 1 ] && sudo -n rm -f /usr/sbin/policy-rc.d; kill ${KEEP:-0} ${TAILPID:-0} 2>/dev/null' EXIT
  sudo -n dpkg --configure -a </dev/null >/dev/null 2>&1
}

# ================= repositorios apt de terceiros (docs oficiais, conferidos em 2026-10-07) =================
repo_docker() {
  S install -m 0755 -d /etc/apt/keyrings
  S curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc && S chmod a+r /etc/apt/keyrings/docker.asc
  printf 'Types: deb\nURIs: https://download.docker.com/linux/ubuntu\nSuites: %s\nComponents: stable\nArchitectures: %s\nSigned-By: /etc/apt/keyrings/docker.asc\n' \
    "$(. /etc/os-release && echo "${UBUNTU_CODENAME:-$VERSION_CODENAME}")" "$(dpkg --print-architecture)" | S tee /etc/apt/sources.list.d/docker.sources >/dev/null
  DOCKER_PKGS=(docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin)
}
repo_hashicorp() {
  local t; t=$(mktemp)
  curl -fsSL https://apt.releases.hashicorp.com/gpg -o "$t" && [ -s "$t" ] || { echo "falha ao baixar chave HashiCorp; repo pulado"; rm -f "$t"; return 1; }
  gpg --dearmor < "$t" 2>/dev/null | S tee /usr/share/keyrings/hashicorp-archive-keyring.gpg >/dev/null; rm -f "$t"
  echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/hashicorp-archive-keyring.gpg] https://apt.releases.hashicorp.com $(. /etc/os-release && echo "${UBUNTU_CODENAME:-$VERSION_CODENAME}") main" | S tee /etc/apt/sources.list.d/hashicorp.list >/dev/null
  return 0
}
repo_helm() {
  local id="DDF78C3E6EBB2D2CC223C95C62BA89D07698DBC6" t; t=$(mktemp)
  curl -fsSL https://packages.buildkite.com/helm-linux/helm-debian/gpgkey > "$t"
  [ "$(gpg --show-keys --with-colons "$t" | awk -F: '$1=="fpr"{print $10}' | head -n1)" = "$id" ] || { echo "chave do Helm inesperada; abortando repo helm"; return 1; }
  gpg --dearmor < "$t" | S tee /usr/share/keyrings/helm.gpg >/dev/null
  echo "deb [signed-by=/usr/share/keyrings/helm.gpg] https://packages.buildkite.com/helm-linux/helm-debian/any/ any main" | S tee /etc/apt/sources.list.d/helm-stable-debian.list >/dev/null
  REPO_PKGS+=(helm)
}
repo_grafana() {
  S mkdir -p /etc/apt/keyrings
  S wget -qO /etc/apt/keyrings/grafana.asc https://apt.grafana.com/gpg-full.key && S chmod 644 /etc/apt/keyrings/grafana.asc
  echo "deb [signed-by=/etc/apt/keyrings/grafana.asc] https://apt.grafana.com stable main" | S tee /etc/apt/sources.list.d/grafana.list >/dev/null
  REPO_PKGS+=(grafana)
}

# chaves de repos apt ja existentes na maquina podem ficar velhas (o fornecedor troca a chave de assinatura): renova do dominio oficial
renovar_chaves() {
  local t
  if [ -f /etc/apt/sources.list.d/github-cli.list ]; then t=$(mktemp)
    curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg -o "$t" && [ -s "$t" ] && S install -m 0644 "$t" /usr/share/keyrings/githubcli-archive-keyring.gpg >>"$LOG" 2>&1 && echo "chave gh renovada" >>"$LOG"; rm -f "$t"; fi
  if [ -f /etc/apt/sources.list.d/hashicorp.list ]; then t=$(mktemp)
    curl -fsSL https://apt.releases.hashicorp.com/gpg -o "$t" && [ -s "$t" ] && gpg --dearmor < "$t" 2>/dev/null | S tee /usr/share/keyrings/hashicorp-archive-keyring.gpg >/dev/null && echo "chave hashicorp renovada" >>"$LOG"; rm -f "$t"; fi
  return 0
}

# ================= pos-instalacao (configuracao das ferramentas) =================
pos_base() {  # zsh como shell padrao; identidade git vem do .gitconfig restaurado; starship e zoxide (binarios avulsos)
  [ "$(getent passwd "$USER" | cut -d: -f7 | xargs basename)" = zsh ] || S chsh -s "$(command -v zsh)" "$USER"
  mkdir -p "$H/.local/bin"
  [ -x "$H/.local/bin/starship" ] || command -v starship >/dev/null || { local t; t=$(mktemp -d)
    curl -fsSL https://github.com/starship/starship/releases/latest/download/starship-x86_64-unknown-linux-musl.tar.gz -o "$t/s.tgz" && tar -xzf "$t/s.tgz" -C "$t" starship && install -m 0755 "$t/starship" "$H/.local/bin/starship" || { rm -rf "$t"; return 1; }; rm -rf "$t"; }
  [ -x "$H/.local/bin/zoxide" ] || command -v zoxide >/dev/null || { local z; z=$(mktemp)
    curl -fsSL https://raw.githubusercontent.com/ajeetdsouza/zoxide/main/install.sh -o "$z" && sh "$z" --bin-dir "$H/.local/bin" </dev/null || { rm -f "$z"; return 1; }; rm -f "$z"; }
  return 0
}
pos_devops() {  # docker: grupo + servico (so com systemd ativo)
  S usermod -aG docker "$USER"
  if [ -d /run/systemd/system ]; then S systemctl enable --now docker; else echo "systemd inativo: docker so sobe apos reiniciar a distro (wsl -t <nome>)"; fi
}

pos_go() {  # goenv (clone) + versoes do Go registradas em packages/goenv-versions.txt
  local P="$(czsrc)/packages" v
  [ -d "$H/.goenv" ] || git clone --depth 1 https://github.com/go-nv/goenv.git "$H/.goenv" || return 1
  [ -f "$P/goenv-versions.txt" ] && while read -r v; do [ -n "$v" ] || continue; [ -d "$H/.goenv/versions/$v" ] || GOENV_ROOT="$H/.goenv" "$H/.goenv/bin/goenv" install -s "$v" </dev/null || return 1; done < "$P/goenv-versions.txt"
  [ -s "$P/goenv-global.txt" ] && cp -f "$P/goenv-global.txt" "$H/.goenv/version"
  return 0
}
pos_bun() {  # bun via instalador oficial; ele acrescenta linhas nos rc: desfaz (os rc ja vem do chezmoi)
  [ -x "$H/.bun/bin/bun" ] && return 0
  local f bk; bk=$(mktemp -d); for f in .bashrc .zshrc .zshenv .profile .zprofile; do [ -f "$H/$f" ] && cp -p "$H/$f" "$bk/$f"; done
  curl -fsSL -o "$STATE/bun-install.sh" https://bun.sh/install && bash "$STATE/bun-install.sh" </dev/null; local rc=$?
  for f in .bashrc .zshrc .zshenv .profile .zprofile; do [ -f "$bk/$f" ] && cp -p "$bk/$f" "$H/$f"; done; rm -rf "$bk"
  return $rc
}

# ================= binarios avulsos por perfil (catalogo binarios.tsv; fontes oficiais) =================
bin_ghrel() {  # $1 nome ; $2 "owner/repo|asset|binario-no-arquivo" ({tag} e {ver} sao substituidos pela ultima tag estavel)
  local n="$1" repo asset bin tag ver t u f rc
  IFS='|' read -r repo asset bin <<<"$2"; bin="${bin:-$n}"
  tag=$(git ls-remote --tags --refs --sort=-v:refname "https://github.com/$repo.git" 2>/dev/null | awk '{sub("refs/tags/","",$2); print $2}' | grep -viE 'rc|alpha|beta|dev|nightly|pre|snapshot' | grep -E '^v?[0-9]+\.[0-9]+' | head -1)
  [ -n "$tag" ] || { echo "sem tag estavel em $repo" >>"$LOG"; return 1; }
  ver="${tag#v}"; asset="${asset//\{tag\}/$tag}"; asset="${asset//\{ver\}/$ver}"
  t=$(mktemp -d); u="https://github.com/$repo/releases/download/$tag/$asset"
  curl -fsSL "$u" -o "$t/$asset" >>"$LOG" 2>&1 || { echo "download falhou: $u" >>"$LOG"; rm -rf "$t"; return 1; }
  case "$asset" in
    *.tar.gz|*.tgz) tar -xzf "$t/$asset" -C "$t" >>"$LOG" 2>&1; f=$(find "$t" -type f -name "$bin" | head -1)
      [ -n "$f" ] || { echo "binario $bin nao esta em $asset" >>"$LOG"; rm -rf "$t"; return 1; }; install -m 0755 "$f" "$H/.local/bin/$n"; rc=$?;;
    *) install -m 0755 "$t/$asset" "$H/.local/bin/$n"; rc=$?;;
  esac; rm -rf "$t"; return $rc
}
bin_gomod() {  # $1 nome ; $2 modulo@versao ; precisa de Go via goenv (instala se faltar)
  local g="$H/.goenv/shims"
  [ -x "$g/go" ] || { pos_go </dev/null >>"$LOG" 2>&1; GOENV_ROOT="$H/.goenv" "$H/.goenv/bin/goenv" rehash >>"$LOG" 2>&1; }
  [ -x "$g/go" ] || { echo "go indisponivel via goenv (packages/goenv-versions.txt vazio? rode 'initio sync' na maquina original)" >>"$LOG"; return 1; }
  GOENV_ROOT="$H/.goenv" PATH="$g:$H/.goenv/bin:$PATH" GOBIN="$H/go/bin" go install "$2" >>"$LOG" 2>&1
}
bin_kubectl() {  # fonte oficial dl.k8s.io (padrao da documentacao do Kubernetes)
  local v t rc; v=$(curl -fsSL https://dl.k8s.io/release/stable.txt) && [ -n "$v" ] || return 1
  t=$(mktemp); curl -fsSL "https://dl.k8s.io/release/$v/bin/linux/amd64/kubectl" -o "$t" >>"$LOG" 2>&1 && install -m 0755 "$t" "$H/.local/bin/kubectl"; rc=$?; rm -f "$t"; return $rc
}
binarios_perfil() {  # $1 = perfil
  local T="$INITIO_HOME/binarios.tsv" p n m sp; [ -f "$T" ] || return 0; mkdir -p "$H/.local/bin"
  while IFS=$'\t' read -r p n m sp; do
    case "$p" in ""|\#*) continue;; esac; [ "$p" = "$1" ] || continue
    { [ -x "$H/.local/bin/$n" ] || [ -x "$H/go/bin/$n" ] || command -v "$n" >/dev/null 2>&1; } && continue
    case "$m" in
      ghrel) bin_ghrel "$n" "$sp" </dev/null;; gomod) bin_gomod "$n" "$sp" </dev/null;; kubectl) bin_kubectl </dev/null;;
      *) false;;
    esac && ok "binario $n" || bad "binario $n"
  done < "$T"
}

# ================= instalacao de um perfil (idempotente) =================
apt_faltando() { local p; for p in "$@"; do [ -n "$p" ] || continue; dpkg -s "$p" >/dev/null 2>&1 || echo "$p"; done; }
apt_instalar() { local n=0 f=0 p; for p in "$@"; do [ -n "$p" ] || continue
  if S timeout 300 apt-get install -y -o Dpkg::Options::=--force-confold "$p" >>"$LOG" 2>&1 </dev/null; then n=$((n+1)); else f=$((f+1)); echo "   apt FALHOU: $p"; echo "$p" >> "$H/initio-apt-falhou.txt"; fi; done; ok "apt ($n instalados, $f falharam)"; }

instalar_perfil() {
  local p="$1" f="$INITIO_HOME/perfis/$1.conf"
  [ -f "$f" ] || { echo "perfil inexistente: $p (initio list)"; return 1; }
  DESC=""; APT=(); REPOS=(); NPM=(); NODE=(); SDK=(); PIP=(); PIPX=(); CARGO=(); CONDA=(); CONFIGS=(); RUST=0; POS=""; PIP_FILE=""; REPO_PKGS=(); DOCKER_PKGS=()
  # shellcheck disable=SC1090
  . "$f"
  say "=== perfil: $p - $DESC"
  if [ $DRY = 1 ]; then
    echo "   apt: ${APT[*]:-}  repos: ${REPOS[*]:-}"; echo "   node: ${NODE[*]:-}  npm: ${NPM[*]:-}  sdk: ${SDK[*]:-}"
    echo "   pip: ${PIP[*]:-} ${PIP_FILE}  pipx: ${PIPX[*]:-}  cargo: ${CARGO[*]:-}  conda: ${CONDA[*]:-}  rust: $RUST"; return 0
  fi
  sudo_prep; : >> "$LOG"
  S apt-get update -y >>"$LOG" 2>&1 </dev/null
  local r; for r in "${REPOS[@]:-}"; do [ -n "$r" ] || continue; dpkg -s "$( [ "$r" = docker ] && echo docker-ce || echo "$r")" >/dev/null 2>&1 && continue
    "repo_$r" >>"$LOG" 2>&1 && ok "repo $r" || bad "repo $r"; done
  [ ${#REPOS[@]} -gt 0 ] && S apt-get update -y >>"$LOG" 2>&1 </dev/null
  local todo; todo=$(apt_faltando "${APT[@]:-}" "${DOCKER_PKGS[@]:-}" "${REPO_PKGS[@]:-}")
  # shellcheck disable=SC2086
  [ -n "$todo" ] && apt_instalar $todo
  [ $UPGRADE = 1 ] && [ -n "${APT[*]:-}" ] && S apt-get install -y --only-upgrade "${APT[@]}" >>"$LOG" 2>&1 </dev/null
  if [ ${#NODE[@]} -gt 0 ] || [ ${#NPM[@]} -gt 0 ]; then
    [ -d "$H/.nvm" ] || { git clone -q https://github.com/nvm-sh/nvm.git "$H/.nvm" && ( cd "$H/.nvm" && git checkout -q "$(git describe --abbrev=0 --tags --match 'v[0-9]*' "$(git rev-list --tags --max-count=1)")" ); }
    export NVM_DIR="$H/.nvm"; set +u; . "$NVM_DIR/nvm.sh" 2>/dev/null
    local v; for v in "${NODE[@]:-}"; do [ -n "$v" ] || continue; [ -d "$NVM_DIR/versions/node/$v" ] && continue; nvm install "$v" >>"$LOG" 2>&1 </dev/null && ok "node $v" || bad "node $v"; done
    local n; for n in "${NPM[@]:-}"; do [ -n "$n" ] || continue; npm ls -g --depth=0 "$n" >/dev/null 2>&1 && continue; npm install -g "$n" >>"$LOG" 2>&1 </dev/null && ok "npm -g $n" || bad "npm -g $n"; done; set -u
  fi
  if [ ${#SDK[@]} -gt 0 ]; then
    [ -d "$H/.sdkman" ] || curl -fsSL https://get.sdkman.io | bash >>"$LOG" 2>&1
    if [ -s "$H/.sdkman/bin/sdkman-init.sh" ]; then
      sed -i 's/sdkman_auto_answer=false/sdkman_auto_answer=true/' "$H/.sdkman/etc/config" 2>/dev/null
      set +u; . "$H/.sdkman/bin/sdkman-init.sh"
      local s c2 v2; for s in "${SDK[@]}"; do c2=${s%% *}; v2=${s#* }; [ -d "$H/.sdkman/candidates/$c2/$v2" ] && continue
        sdk install $s </dev/null >>"$LOG" 2>&1 && ok "sdk $s" || bad "sdk $s"; done; set -u
    else bad sdkman; fi
  fi
  if { [ "$RUST" = 1 ] || [ ${#CARGO[@]} -gt 0 ]; } && ! command -v rustup >/dev/null; then
    curl --proto '=https' --tlsv1.2 -fsSL -o "$STATE/rustup-init.sh" https://sh.rustup.rs >>"$LOG" 2>&1 && sh "$STATE/rustup-init.sh" -y >>"$LOG" 2>&1 </dev/null && [ -x "$H/.cargo/bin/rustup" ] && ok rust || bad rust; fi
  # shellcheck disable=SC1091
  [ -f "$H/.cargo/env" ] && . "$H/.cargo/env"
  local k; for k in "${CARGO[@]:-}"; do [ -n "$k" ] || continue; cargo install --list 2>/dev/null | grep -q "^$k v" && continue
    cargo install --locked "$k" >>"$LOG" 2>&1 </dev/null && ok "cargo $k" || bad "cargo $k"; done
  local x nm; for x in "${PIPX[@]:-}"; do [ -n "$x" ] || continue; nm="$x"; case "$x" in git+*) nm="${x##*/}"; nm="${nm%.git}";; esac
    pipx list --short 2>/dev/null | grep -q "^$nm " && continue
    pipx install "$x" >>"$LOG" 2>&1 </dev/null && ok "pipx $x" || bad "pipx $x"; done
  local cb="$H/miniconda3/bin/conda"
  if [ ${#CONDA[@]} -gt 0 ]; then
    [ -x "$cb" ] || { curl -fsSL -o /tmp/mc.sh https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh && bash /tmp/mc.sh -b -p "$H/miniconda3" >>"$LOG" 2>&1 && ok miniconda || bad miniconda; }
    if [ "${ACEITO_TOS_CONDA:-0}" = 1 ] && [ -x "$cb" ] && "$cb" tos --help >/dev/null 2>&1; then
      "$cb" tos accept --override-channels --channel https://repo.anaconda.com/pkgs/main >>"$LOG" 2>&1
      "$cb" tos accept --override-channels --channel https://repo.anaconda.com/pkgs/r >>"$LOG" 2>&1
    fi
    local e PK="$(czsrc)/packages"
    for e in "${CONDA[@]}"; do [ -d "$H/miniconda3/envs/$e" ] && continue
      [ "${ACEITO_TOS_CONDA:-0}" = 1 ] || { bad "conda env $e (termos nao aceitos)"; continue; }
      [ -f "$PK/conda-$e.yml" ] || { bad "conda env $e (sem $PK/conda-$e.yml)"; continue; }
      "$cb" env create -y -n "$e" -f "$PK/conda-$e.yml" >>"$LOG" 2>&1 </dev/null && ok "conda env $e" || bad "conda env $e"; done
  fi
  if [ ${#PIP[@]} -gt 0 ] || [ -n "$PIP_FILE" ]; then
    local q; for q in "${PIP[@]:-}"; do [ -n "$q" ] || continue; pip install --user --break-system-packages "$q" >>"$LOG" 2>&1 </dev/null && ok "pip $q" || bad "pip $q"; done
    local PK2="$(czsrc)/packages"
    if [ -n "$PIP_FILE" ] && [ -s "$PK2/$PIP_FILE" ]; then
      local pn=0 pf=0 IGN="$INITIO_HOME/ignore.txt"; while read -r q; do case "$q" in ""|\#*) continue;; esac
        [ -s "$IGN" ] && grep -qFf <(grep -v '^$' "$IGN") <<<"$q" && continue
        pip show "${q%%=*}" >/dev/null 2>&1 && continue
        pip install --user --break-system-packages "$q" >>"$LOG" 2>&1 </dev/null && pn=$((pn+1)) || { pf=$((pf+1)); echo "$q" >> "$H/initio-pip-falhou.txt"; }
      done < "$PK2/$PIP_FILE"; ok "pip ($PIP_FILE: $pn novos, $pf falharam -> ~/initio-pip-falhou.txt)"
    fi
  fi
  binarios_perfil "$p"
  [ -n "$POS" ] && { "$POS" >>"$LOG" 2>&1 && ok "config: $POS" || bad "config: $POS"; }
  grep -qx "$p" "$STATE/instalados" 2>/dev/null || echo "$p" >> "$STATE/instalados"
}

pergunta_conda() {
  [ -n "${ACEITO_TOS_CONDA:-}" ] && return
  grep -qs '^CONDA=(.\+' "$INITIO_HOME"/perfis/*.conf || return
  { printf '\n>>> Conda exige aceitar os Termos de Servico dos canais da Anaconda. Aceitar em seu nome? [s/N] ' >/dev/tty; } 2>/dev/null || printf 'Conda exige aceitar os Termos de Servico dos canais da Anaconda. Aceitar em seu nome? [s/N] '
  r=n; if { : </dev/tty; } 2>/dev/null; then read -r r </dev/tty; fi
  case "$r" in s|S|sim|SIM) ACEITO_TOS_CONDA=1;; *) ACEITO_TOS_CONDA=0;; esac; export ACEITO_TOS_CONDA
  if [ "$ACEITO_TOS_CONDA" = 1 ] && [ -x "$H/miniconda3/bin/conda" ] && "$H/miniconda3/bin/conda" tos --help >/dev/null 2>&1; then
    "$H/miniconda3/bin/conda" tos accept --override-channels --channel https://repo.anaconda.com/pkgs/main >>"$LOG" 2>&1
    "$H/miniconda3/bin/conda" tos accept --override-channels --channel https://repo.anaconda.com/pkgs/r >>"$LOG" 2>&1
  fi
}
instalar_lista() {
  [ $DRY = 0 ] && { sudo_prep; renovar_chaves; }   # todas as perguntas juntas no inicio: sudo, depois termos do conda; depois roda sozinho
  pergunta_conda
  local _o=(base) _x; for _x in "${PERFIS[@]}"; do [ "$_x" = base ] || printf '%s\n' "${_o[@]}" | grep -qx "$_x" || _o+=("$_x"); done; PERFIS=("${_o[@]}")
  local p; for p in "${PERFIS[@]}"; do instalar_perfil "$p"; done
  [ $DRY = 0 ] && { echo; echo "Detalhes: $LOG"; echo "=== RESULTADO"; printf '%s\n' "${RES[@]:-}"; }
}

# ================= restore: maquina nova -> acessos + dotfiles + repos =================
cofre_baixar() {  # baixa o release mais recente do repo privado do cofre; login por codigo de dispositivo (2FA no celular)
  local R="${INITIO_COFRE_REPO:-netomantonio/cofre}" d="$STATE/cofre-dl"
  command -v gh >/dev/null || return 1
  gh auth status >/dev/null 2>&1 || gh auth login --hostname github.com --git-protocol https --web </dev/tty || return 1
  mkdir -p "$d"; chmod 700 "$d"
  gh release download --repo "$R" --pattern '*.age' --dir "$d" --clobber || return 1
  echo "$d"
}
cmd_restore() {
  local D COFRE KEY; D="$(cofre_dir)"
  COFRE="${1:-$(ls -1t "$D"/wsl-segredos-*.tar.age 2>/dev/null | head -1)}"; KEY="${2:-$D/chezmoi-age-key.txt.age}"
  cd "$H" || return 1; sudo_prep
  say "1/5 pacotes base"; S apt-get update -y >>"$LOG" 2>&1; S apt-get install -y git curl age ca-certificates gnupg python3 python3-pip rsync gh >>"$LOG" 2>&1 </dev/null || { echo "apt base falhou (ver $LOG)"; return 1; }
  if ! { [ -f "${COFRE:-}" ] && [ -f "$KEY" ]; }; then
    say "   cofre local nao encontrado; baixando do GitHub privado (${INITIO_COFRE_REPO:-netomantonio/cofre})"
    D="$(cofre_baixar)" || { echo "nao consegui baixar o cofre. Confira: repo/release existem? login do gh ok? Ou passe: initio restore <cofre.tar.age> <chave.txt.age>"; return 1; }
    COFRE="$(ls -1t "$D"/wsl-segredos-*.tar.age 2>/dev/null | head -1)"; KEY="$D/chezmoi-age-key.txt.age"
    [ -f "${COFRE:-}" ] && [ -f "$KEY" ] || { echo "release sem wsl-segredos-*.tar.age e chezmoi-age-key.txt.age"; return 1; }
  fi
  grep -qs '^systemd *= *true' /etc/wsl.conf || { printf '\n[boot]\nsystemd=true\n' | S tee -a /etc/wsl.conf >/dev/null; say "systemd habilitado em /etc/wsl.conf (vale no proximo reinicio da distro)"; }
  say "2/5 cofre -> $H (senha do cofre)"; age_d "$COFRE" | tar -xzf - -C "$H" || { echo "falha ao abrir o cofre (senha errada?)"; return 1; }
  local IS; IS="$(ls -1t "${D:-/nonexistent}"/initio-segredos-*.tar.age 2>/dev/null | head -1)"
  [ -f "${IS:-}" ] && { say "   segredos do initio (chave ssh do GitHub etc; mesma senha do cofre)"; age_d "$IS" | tar -xzf - -C "$H" || echo "aviso: nao abri $IS"; }
  chmod 700 "$H/.ssh" "$H/.gnupg" 2>/dev/null; chmod 600 "$H"/.ssh/id_* 2>/dev/null
  [ -f "$H/.ssh/id_ed25519_github" ] && ssh_config_garantir "$H/.ssh/id_ed25519_github"
  say "3/5 chave age do chezmoi (senha do cofre)"; mkdir -p "$H/.config/chezmoi"; chmod 700 "$H/.config/chezmoi"
  age_d -o "$H/.config/chezmoi/key.txt" "$KEY" || { echo "falha ao abrir a chave"; return 1; }; chmod 600 "$H/.config/chezmoi/key.txt"
  printf 'encryption = "age"\n[age]\n    identity = "%s/.config/chezmoi/key.txt"\n    recipient = "%s"\n' "$H" "$(age-keygen -y "$H/.config/chezmoi/key.txt")" > "$H/.config/chezmoi/chezmoi.toml"
  say "4/5 dotfiles (chezmoi)"; command -v chezmoi >/dev/null || sh -c "$(curl -fsSL get.chezmoi.io)" -- -b "$H/.local/bin"
  chezmoi init --apply netomantonio || { echo "chezmoi falhou"; return 1; }
  say "5/5 repos"; local SRC rel url br; SRC="$(czsrc)"
  if gh auth status >/dev/null 2>&1; then
    while IFS=$'\t' read -r rel url br; do [ -n "$rel" ] || continue; local d="$H/$rel"
      [ -d "$d/.git" ] && { say "   ja existe: $rel"; continue; }
      mkdir -p "$d"; git -C "$d" init -q; git -C "$d" remote add origin "$url"
      if GIT_TERMINAL_PROMPT=0 git -C "$d" fetch -q origin 2>/dev/null; then git -C "$d" checkout -q -f -B "$br" "origin/$br" 2>/dev/null || git -C "$d" checkout -q -f -B main origin/main 2>/dev/null; say "   ok: $rel ($br)"; else say "   FALHOU o fetch (sem permissao ou repo removido?): $rel - pulado, tentara de novo no proximo restore"; rm -rf "$d/.git"; rmdir "$d" 2>/dev/null; fi
    done < "$SRC/repos.tsv"
  else say "gh nao autenticado: o cofre deveria ter trazido o login; rode 'gh auth login' e 'initio restore' de novo"; fi
  say "restore ok. Proximo: initio all  (ou initio <perfil>)"
}

# ================= snapshot: captura configs e dependencias desta maquina =================
add_file() {  # $1 = arquivo absoluto
  local f="$1"; [ -f "$f" ] && [ ! -L "$f" ] || return
  [ "$(stat -c %s "$f")" -gt 1048576 ] && { echo "   pula (>1MB): ${f#$H/}"; return; }
  if grep -qIEi "$SEGRE" "$f" 2>/dev/null; then CRIPTO=$((CRIPTO+1)); [ $DRY = 0 ] && chezmoi add --encrypt "$f" >/dev/null 2>&1
  else TEXTO=$((TEXTO+1)); [ $DRY = 0 ] && chezmoi add "$f" >/dev/null 2>&1; fi
}
add_path() {
  local p="$H/$1" f; [ -e "$p" ] || return
  [ -f "$p" ] && { add_file "$p"; return; }
  while IFS= read -r -d '' f; do add_file "$f"; done < <(find "$p" -type f -not -path '*/.git/*' -not -path '*/node_modules/*' -not -path '*/__pycache__/*' -not -path '*/cache/*' -not -path '*/.cache/*' -not -path '*/skills/synced/*' -not -path '*/skills/.system/*' -not -path '*/skills/graphify/*' -not -path '*/yazi/plugins/*' -not -path '*/yazi/flavors/*' -not -name '*.lock' -not -name 'package-lock.json' -print0 2>/dev/null)
}
lista_conhecidos() {  # nomes ja cobertos pelos perfis (um por linha) para o array $1
  local f; for f in "$INITIO_HOME"/perfis/*.conf; do ( APT=(); NPM=(); PIP=(); CARGO=(); PIPX=(); . "$f"; eval "printf '%s\n' \"\${$1[@]:-}\"" ); done | sed 's/@[^@]*$//' | sed '/^git+/{s#.*/##;s#\.git$##}' | sort -u
}
extras_add() {  # $1 = array (APT|NPM|CARGO|PIPX) ; stdin = nomes novos
  local arr="$1" f="$INITIO_HOME/perfis/extras.conf" novos; novos=$(grep -v '^$' | tr '\n' ' ' | sed 's/ $//')
  [ -n "$novos" ] || return
  [ $DRY = 1 ] && { echo "   [dry] novo: $arr += $novos"; return; }
  [ -f "$f" ] || printf 'DESC="Dependencias que apareceram no uso (detectadas pelo initio snapshot/sync)"\n' > "$f"
  if grep -q "^$arr=(" "$f"; then sed -i "s/^$arr=(\(.*\))$/$arr=(\1 $novos)/" "$f"; else echo "$arr=($novos)" >> "$f"; fi
  echo "   novo em extras.conf: $arr += $novos   -> escolha o perfil: initio perfil move ${arr,,} <pacote> <perfil>   (perfis: initio list)"
}
cmd_snapshot() {
  command -v chezmoi >/dev/null || { echo "chezmoi nao instalado (initio restore)"; return 1; }
  local SRC; SRC="$(czsrc)"; [ -d "$SRC/.git" ] || { echo "sem repo chezmoi em $SRC"; return 1; }
  TEXTO=0; CRIPTO=0
  [ $DRY = 0 ] && { say "-- dotfiles portateis (/home/<usuario> -> \$HOME)"; cmd_portar; }
  say "-- configs (union dos CONFIGS de cada perfil)"
  local f c; for f in "$INITIO_HOME"/perfis/*.conf; do CONFIGS=(); ( . "$f"; printf '%s\n' "${CONFIGS[@]:-}" ); done | sort -u | while read -r c; do [ -n "$c" ] && echo "$c"; done > "$STATE/configs.lista"
  while read -r c; do add_path "$c"; done < "$STATE/configs.lista"
  say "   configs: texto=$TEXTO cripto=$CRIPTO"
  # arquivos ja gerenciados: atualiza o que mudou durante o uso
  [ $DRY = 0 ] && chezmoi re-add >/dev/null 2>&1
  say "-- dependencias novas (fora dos perfis) -> extras.conf"
  local ign="$INITIO_HOME/ignore.txt"; touch "$ign"
  local con; con="$(lista_conhecidos APT; grep -qs '^REPOS=(.*docker' "$INITIO_HOME"/perfis/*.conf && printf '%s\n' docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin; grep -qs '^REPOS=(.*helm' "$INITIO_HOME"/perfis/*.conf && echo helm; grep -qs '^REPOS=(.*grafana' "$INITIO_HOME"/perfis/*.conf && echo grafana; grep -qs '^REPOS=(.*hashicorp' "$INITIO_HOME"/perfis/*.conf && printf '%s\n' vagrant terraform vault consul)"
  dpkg-query -W -f='${Package} ${Priority}\n' $(apt-mark showmanual 2>/dev/null) 2>/dev/null | awk '$2!="required" && $2!="important"{print $1}' | grep -Ev '^(linux-|ubuntu-|snapd|lxd|cloud-|grub|wsl)' | sort -u \
    | comm -23 - <({ printf '%s\n' "$con"; cat "$ign"; } | sort -u) | extras_add APT
  if command -v npm >/dev/null && case "$(command -v npm)" in /mnt/*) false;; esac; then
    npm ls -g --depth=0 --parseable 2>/dev/null | tail -n +2 | sed 's#.*/node_modules/##' | grep -Ev '^(npm|corepack)$' | sort -u | comm -23 - <({ lista_conhecidos NPM; cat "$ign"; } | sort -u) | extras_add NPM
  fi
  [ -f "$H/.cargo/env" ] && . "$H/.cargo/env"
  command -v cargo >/dev/null && cargo install --list 2>/dev/null | awk '/^[^ ]/{print $1}' | sort -u | comm -23 - <({ lista_conhecidos CARGO; cat "$ign"; } | sort -u) | extras_add CARGO
  command -v pipx >/dev/null && pipx list --short 2>/dev/null | awk '{print $1}' | sort -u | comm -23 - <({ lista_conhecidos PIPX; cat "$ign"; } | sort -u) | extras_add PIPX
  [ $DRY = 1 ] && return 0
  say "-- listas em packages/ (pip --user, envs conda, sdkman, nvm)"
  local PK="$SRC/packages"; mkdir -p "$PK"
  pip list --user --format=freeze 2>/dev/null | grep -v ' @ ' | { if [ -s "$ign" ]; then grep -vFf <(grep -v '^$' "$ign"); else cat; fi; } > "$PK/pip-user.txt"
  local cb="$H/miniconda3/bin/conda" e
  [ -x "$cb" ] && for e in $("$cb" env list 2>/dev/null | awk '$1!="#" && NF>0 && $1!="base"{print $1}'); do "$cb" env export --no-builds -n "$e" > "$PK/conda-$e.yml" 2>/dev/null; done
  { echo '# sdkman'; ls "$H"/.sdkman/candidates/*/ 2>/dev/null; echo '# nvm'; ls "$H/.nvm/versions/node" 2>/dev/null; } > "$PK/runtimes.txt"
  apt-mark showmanual 2>/dev/null > "$PK/apt-manual.txt"
  # repos (proprios e externos: so registra url+branch, nunca faz push)
  find "$H" -maxdepth 6 -name .git -type d 2>/dev/null | grep -Ev '/(node_modules|\.venv|venv|\.cache|\.npm|miniconda3|\.nvm|\.cargo|\.rustup|\.sdkman|\.oh-my-zsh|\.goenv|\.zsh|\.tmux|\.vim|\.config|\.bun|\.pyenv|\.rbenv|site-packages|vendor|_QUARENTENA|_da-wsl)(/|$)|\.local/(share|state)|/\.(claude|codex)/' | sed 's#/\.git$##' | sort | while read -r r; do
    u=$(git -C "$r" remote get-url origin 2>/dev/null | sed -E 's#https://[^@]*@#https://#'); [ -n "$u" ] || continue
    b=$(git -C "$r" branch --show-current 2>/dev/null); printf '%s\t%s\t%s\n' "${r#$H/}" "$u" "${b:-main}"; done > "$SRC/repos.tsv.new" && mv "$SRC/repos.tsv.new" "$SRC/repos.tsv"
  say "   repos.tsv: $(wc -l < "$SRC/repos.tsv") repos"
  [ -d "$H/.goenv/versions" ] && { ls -1 "$H/.goenv/versions" > "$PK/goenv-versions.txt" 2>/dev/null; cp -f "$H/.goenv/version" "$PK/goenv-global.txt" 2>/dev/null; true; }
}

# ================= sync: capturar -> publicar -> puxar -> aplicar -> instalar o que falta =================
self_install() {  # instala/atualiza a copia local (~/.local) a partir de onde o initio esta rodando
  local T="$H/.local/share/initio"; mkdir -p "$H/.local/bin" "$T/perfis"
  if [ "$INITIO_HOME" != "$T" ]; then
    cp -f "$INITIO_HOME"/perfis/*.conf "$T/perfis/"; [ -f "$INITIO_HOME/ignore.txt" ] && cp -f "$INITIO_HOME/ignore.txt" "$T/"; [ -f "$INITIO_HOME/binarios.tsv" ] && cp -f "$INITIO_HOME/binarios.tsv" "$T/"
    INITIO_HOME="$T"
  fi
  [ "$SELF" = "$H/.local/bin/initio" ] || { cp -f "$SELF" "$H/.local/bin/initio"; chmod +x "$H/.local/bin/initio"; }
}
cz_ignorar() {  # arquivos de DADOS do repo chezmoi nao podem virar arquivos da home: chezmoi re-add sobrescrevia o catalogo com a copia velha de ~/
  local SRC="$1" f; for f in projetos-repos.tsv repos.tsv; do grep -qxF "$f" "$SRC/.chezmoiignore" 2>/dev/null || echo "$f" >> "$SRC/.chezmoiignore"; done
}

cmd_sync() {
  command -v chezmoi >/dev/null || { echo "chezmoi nao instalado (initio restore)"; return 1; }
  local SRC; SRC="$(czsrc)"
  [ $DRY = 0 ] && cz_ignorar "$SRC"
  if [ $DRY = 0 ]; then
    say "0/5 perguntas (tudo agora; depois roda sozinho)"
    pergunta_conda; sudo_prep
  fi
  say "1/5 puxando mudancas de outras maquinas"
  # catalogo/arquivos locais viram commit ANTES do pull: autostash pode perder ou conflitar
  git -C "$SRC" add -A >/dev/null 2>&1; git -C "$SRC" commit -q -m "initio sync (pre-pull) $(date +%F\ %H:%M) @$(hostname)" >/dev/null 2>&1 || true
  if ! PULL_OUT=$(git -C "$SRC" pull -q --rebase 2>&1); then bad "pull falhou (nada foi perdido, seu commit local esta intacto):"; echo "$PULL_OUT" | tail -8; return 1; fi
  [ $DRY = 0 ] && self_install
  say "2/5 capturando esta maquina"; cmd_snapshot
  [ $DRY = 1 ] && { echo "[dry] pararia aqui (nao publica nem instala)"; return 0; }
  say "3/5 publicando initio + perfis nos dotfiles"
  chezmoi add "$H/.local/bin/initio" "$H"/.local/share/initio/perfis/*.conf "$H/.local/share/initio/ignore.txt" "$H/.local/share/initio/binarios.tsv" >/dev/null 2>&1
  git -C "$SRC" add -A
  git -C "$SRC" commit -q -m "initio sync $(date +%F\ %H:%M) @$(hostname)" 2>/dev/null || echo "   nada novo para commitar"
  git -C "$SRC" push -q 2>&1 | tail -2
  say "4/5 aplicando"; chezmoi apply >/dev/null 2>&1
  say "5/5 instalando o que falta nos perfis ja instalados$([ $UPGRADE = 1 ] && echo ' (+upgrade)')"
  PERFIS=(); [ -s "$STATE/instalados" ] && while read -r p; do [ "$p" = extras ] || PERFIS+=("$p"); done < "$STATE/instalados"
  [ -f "$INITIO_HOME/perfis/extras.conf" ] && ! printf '%s\n' "${PERFIS[@]:-}" | grep -qx extras && PERFIS+=(extras)
  [ ${#PERFIS[@]} -gt 0 ] || PERFIS=(base)
  instalar_lista
}

# ================= cofre =================
cmd_cofre() {
  local D; D="$(cofre_dir)"
  case "${1:-}" in
    salvar)
      [ -n "$D" ] || { echo "pasta do cofre nao encontrada"; return 1; }
      local L="$INITIO_HOME/cofre.list" out="$D/initio-segredos-$(date +%F).tar.age" tmp; tmp=$(mktemp)
      [ -f "$L" ] || printf '%s\n' .ssh .gnupg .kube .docker/config.json .aws .npmrc .netrc .pypirc .config/gh .config/argocd .config/sops .claude/settings.local.json .zsh_history .bash_history > "$L"
      ( cd "$H" && { grep -v '^$' "$L" | while read -r x; do [ -e "$x" ] && echo "$x"; done
        find "$H/projects" -maxdepth 5 -type f \( -name '.env' -o -name '.env.*' -o -name '.dev.vars' \) -not -path '*/node_modules/*' -not -name '*.example' -not -name '*.sample' -not -name '*.template' 2>/dev/null | sed "s#^$H/##"; } | sort -u > "$tmp" )
      echo "$(wc -l < "$tmp") itens. A seguir o age vai pedir a SENHA DO COFRE (2x, nao aparece na tela)."
      echo ">>> digite a senha e Enter. NAO deixe vazio (vazio = senha aleatoria que voce nao ve)."
      ( cd "$H" && tar --exclude='.gnupg/S.*' -czf - -T "$tmp" 2>/dev/null ) | age -p -o "$out" && echo "ok: $out" || { rm -f "$out"; echo "falhou"; }; rm -f "$tmp";;
    publicar)  # sobe os arquivos cifrados como release do repo privado (cada release leva o conjunto completo)
      local R="${INITIO_COFRE_REPO:-netomantonio/cofre}" f files=() tag; tag="cofre-$(date +%F-%H%M)"
      [ -n "$D" ] || { echo "pasta do cofre local nao encontrada (OneDrive)"; return 1; }
      for f in "$(ls -1t "$D"/wsl-segredos-*.tar.age 2>/dev/null | head -1)" "$D/chezmoi-age-key.txt.age" "$(ls -1t "$D"/wsl-historico-*.tar.age 2>/dev/null | head -1)" "$(ls -1t "$D"/initio-segredos-*.tar.age 2>/dev/null | head -1)"; do [ -f "$f" ] && files+=("$f"); done
      [ ${#files[@]} -gt 0 ] || { echo "nada para publicar"; return 1; }
      gh repo view "$R" >/dev/null 2>&1 || { echo "repo $R nao existe. Crie PRIVADO: gh repo create $R --private"; return 1; }
      [ "$(gh repo view "$R" --json isPrivate -q .isPrivate 2>/dev/null)" = true ] || { echo "RECUSADO: $R nao e privado"; return 1; }
      # repo vazio nao aceita release (HTTP 422 "Repository is empty"): cria o commit inicial
      gh api "repos/$R/commits?per_page=1" >/dev/null 2>&1 || gh api -X PUT "repos/$R/contents/README.md" -f message="init" -f content="$(printf 'cofre cifrado (age); so arquivos .age em releases\n' | base64 -w0)" >/dev/null 2>&1 || true
      gh release create "$tag" "${files[@]}" --repo "$R" --title "$tag" --notes "cofre cifrado (age)" && echo "publicado: $R @ $tag (${#files[@]} arquivos)";;
    abrir) local a="${2:-$(ls -1t "$D"/*.tar.age 2>/dev/null | head -1)}"; age_d "$a" | tar -xzf - -C "$H" && echo "extraido em $H";;
    *) echo "uso: initio cofre salvar | publicar | abrir [arquivo]";;
  esac
}

# ================= bootstrap publico (sem segredos) =================
cmd_publicar_boot() {
  local R="${INITIO_BOOT_REPO:-netomantonio/bootstrap}" d="$STATE/boot" f
  gh repo view "$R" >/dev/null 2>&1 || { echo "repo $R nao existe. Crie PUBLICO: gh repo create $R --public"; return 1; }
  [ "$(gh repo view "$R" --json isPrivate -q .isPrivate 2>/dev/null)" = false ] || { echo "$R nao e publico (o download na maquina nova nao funcionaria)"; return 1; }
  [ -d "$d/.git" ] || gh repo clone "$R" "$d" -- -q
  git -C "$d" pull -q --rebase 2>/dev/null
  mkdir -p "$d/perfis"; cp -f "$INITIO_HOME"/perfis/*.conf "$d/perfis/"; cp -f "$SELF" "$d/initio"
  for f in ignore.txt binarios.tsv install.sh worker.js; do [ -f "$INITIO_HOME/$f" ] && cp -f "$INITIO_HOME/$f" "$d/$f"; done
  # trava: nada que pareca segredo vai para um repo publico
  local achou; achou=$(grep -rIEn "$SEGRE" "$d" --exclude-dir=.git --exclude=initio --exclude=binarios.tsv 2>/dev/null | grep -v 'getent passwd')
  [ -z "$achou" ] || { echo "RECUSADO: possivel segredo em: $achou"; return 1; }
  git -C "$d" add -A; git -C "$d" commit -q -m "bootstrap $(date +%F\ %H:%M)" 2>/dev/null || echo "nada novo"
  git -C "$d" push -q && echo "publicado: https://github.com/$R"
}

# ================= ssh com o GitHub =================
ssh_config_garantir() {  # $1 = chave privada: garante o bloco "Host github.com" no ~/.ssh/config (idempotente)
  mkdir -p "$H/.ssh"; chmod 700 "$H/.ssh"; touch "$H/.ssh/config"; chmod 600 "$H/.ssh/config"
  grep -q '# initio-github' "$H/.ssh/config" || printf '\n# initio-github\nHost github.com\n  HostName github.com\n  User git\n  IdentityFile %s\n  IdentitiesOnly yes\n  AddKeysToAgent yes\n' "$1" >> "$H/.ssh/config"
}
cmd_sshgh() {  # usa chave local ja cadastrada no GitHub; se nenhuma estiver, cria uma com passphrase e cadastra
  gh auth status >/dev/null 2>&1 || { echo "sem login no gh: rode 'gh auth login --web' e repita"; return 1; }
  if ! gh api user/keys >/dev/null 2>&1; then echo ">>> o gh precisa de permissao para chaves SSH: vai abrir o login no navegador"; gh auth refresh -h github.com -s admin:public_key </dev/tty || return 1; fi
  local keys p b found=""; keys=$(gh api user/keys --jq '.[].key' 2>/dev/null) || { echo "nao consegui listar as chaves do GitHub"; return 1; }
  for p in "$H"/.ssh/*.pub; do [ -f "$p" ] || continue; b=$(awk '{print $2}' "$p"); [ -n "$b" ] && grep -qF "$b" <<<"$keys" && { found="${p%.pub}"; break; }; done
  if [ -z "$found" ]; then
    found="$H/.ssh/id_ed25519_github"
    echo ">>> nenhuma chave local esta cadastrada no GitHub. Criando $found (pede passphrase 2x: use uma, NAO deixe vazio)"
    [ -f "$found" ] || ssh-keygen -t ed25519 -C "$(hostname)-github" -f "$found" </dev/tty || return 1
    gh ssh-key add "$found.pub" --title "$(hostname)-$(date +%F)" || return 1
  else echo "chave ja cadastrada no GitHub: $found"; fi
  ssh_config_garantir "$found"
  ssh -o StrictHostKeyChecking=accept-new -T git@github.com 2>&1 | tee /dev/stderr | grep -q 'successfully authenticated' && echo "OK: ssh com o GitHub funcionando" || { echo "FALHOU: ssh ainda nao autentica"; return 1; }
}

# ================= dotfiles portateis: /home/<usuario> fixo -> $HOME =================
cmd_portar() {
  local f n=0 u="${USER:-$(id -un)}"
  for f in .zshrc .bashrc .zshenv .zprofile .profile; do
    [ -f "$H/$f" ] && grep -q "/home/$u" "$H/$f" || continue
    cp -p "$H/$f" "$H/$f.bak-initio"
    python3 - "$H/$f" "$u" <<'PY'
import sys
p,u=sys.argv[1:3]; lit="/home/"+u; s=open(p).read(); out=[]; i=0
ctx=["code"]; sq=False; n=len(s)
while i<n:
    c=s[i]
    if sq:
        if s.startswith(lit,i): out.append("'\"$HOME\"'"); i+=len(lit); continue
        if c=="'": sq=False
        out.append(c); i+=1; continue
    if c=="\\" and i+1<n: out.append(s[i:i+2]); i+=2; continue
    if s.startswith(lit,i): out.append("$HOME"); i+=len(lit); continue
    t=ctx[-1]
    if t=="dq":
        if c=='"': ctx.pop()
        elif c=="$" and s.startswith("$(",i): ctx.append("cmd"); out.append("$("); i+=2; continue
    else:
        if c=="'": sq=True
        elif c=='"': ctx.append("dq")
        elif t=="cmd" and c==")": ctx.pop()
    out.append(c); i+=1
open(p,"w").write("".join(out))
PY
    if cmp -s "$H/$f" "$H/$f.bak-initio"; then rm -f "$H/$f.bak-initio"; else n=$((n+1)); echo "   portado: $f (backup em $f.bak-initio)"; diff "$H/$f.bak-initio" "$H/$f" | grep '^[<>]' | cut -c1-140; fi
  done
  [ $n -eq 0 ] && echo "   dotfiles ja portateis"; return 0
}

# ================= doctor =================
cmd_doctor() {
  local n=0 f=0; chk() { if eval "$2" >/dev/null 2>&1; then echo "  ok      $1"; n=$((n+1)); else echo "  FALHOU  $1"; f=$((f+1)); fi; }
  chk "gh autenticado" "gh auth status"
  chk "git user.name/email" "[ -n \"\$(git config --global user.name)\" ] && [ -n \"\$(git config --global user.email)\" ]"
  chk "chaves ssh presentes" "ls $H/.ssh/id_*"
  chk "chezmoi sem diferencas" "[ -z \"\$(chezmoi diff 2>/dev/null)\" ]"
  chk "cofre acessivel (OneDrive)" "[ -n \"\$(cofre_dir)\" ]"
  chk "systemd ativo" "[ -d /run/systemd/system ]"
  chk "shell padrao zsh (login shell em /etc/passwd)" "[ \"\$(getent passwd $USER | cut -d: -f7 | xargs basename)\" = zsh ]"
  local t; [ -s "$H/.nvm/nvm.sh" ] && . "$H/.nvm/nvm.sh" >/dev/null 2>&1
  for t in node java python3 cargo conda docker; do command -v "$t" >/dev/null 2>&1 || [ -x "$H/miniconda3/bin/$t" ] && chk "$t no PATH" "command -v $t || [ -x $H/miniconda3/bin/$t ]" || echo "  --      $t nao instalado"; done
  command -v docker >/dev/null && { if docker info >/dev/null 2>&1; then echo "  ok      docker responde"; n=$((n+1)); else echo "  --      docker nao responde (esperado se o docker vem do Windows; senao: wsl -t <distro> para ativar grupo/servico)"; fi; }
  [ -f "$(czsrc)/repos.tsv" ] && { local miss=0 rel; while IFS=$'\t' read -r rel _ _; do [ -d "$H/$rel/.git" ] || miss=$((miss+1)); done < "$(czsrc)/repos.tsv"; chk "repos do repos.tsv clonados (faltam $miss)" "[ $miss -eq 0 ]"; }
  chk "perfis instalados: $(cat "$STATE/instalados" 2>/dev/null | tr '\n' ' ')" "[ -s $STATE/instalados ]"
  echo "$n ok, $f falhas"
}

# ================= perfil add =================
cmd_perfil() {
  if [ "${1:-}" = move ]; then  # initio perfil move <apt|npm|pip|cargo|pipx> <pacote> <perfil-destino>: tira de extras.conf e poe no perfil
    [ $# -eq 4 ] || { echo "uso: initio perfil move <apt|npm|pip|cargo|pipx> <pacote> <perfil-destino>"; return 1; }
    local t="${2^^}" pkg="$3" dst="$4" ex="$INITIO_HOME/perfis/extras.conf" novo
    [ -f "$INITIO_HOME/perfis/$dst.conf" ] || { echo "perfil inexistente: $dst (initio list)"; return 1; }
    novo=$( ( APT=(); NPM=(); PIP=(); CARGO=(); PIPX=(); . "$ex"; eval "for x in \"\${$t[@]:-}\"; do [ \"\$x\" = \"\$pkg\" ] || printf '%s ' \"\$x\"; done" ) ); novo="${novo% }"
    if [ -n "$novo" ]; then sed -i "s|^$t=(.*)\$|$t=($novo)|" "$ex"; else sed -i "/^$t=(/d" "$ex"; fi
    cmd_perfil add "$dst" "$2" "$pkg"; return
  fi
  [ "${1:-}" = add ] && [ $# -ge 4 ] || { echo "uso: initio perfil add <perfil> <apt|npm|pip|cargo|pipx> <pacote>  |  initio perfil move <tipo> <pacote> <perfil>"; return 1; }
  local p="$2" t="${3^^}" pkg="$4" f="$INITIO_HOME/perfis/$2.conf"; [ -f "$f" ] || { echo "perfil inexistente: $p"; return 1; }
  case "$t" in APT|NPM|PIP|CARGO|PIPX) ;; *) echo "tipo invalido: $3"; return 1;; esac
  if grep -q "^$t=(" "$f"; then sed -i "s/^$t=(\(.*\))$/$t=(\1 $pkg)/" "$f"; else echo "$t=($pkg)" >> "$f"; fi
  echo "ok: $t += $pkg em $p (rode 'initio sync' para publicar e instalar)"
}

# ================= repos de projetos: catalogar (url+branch) e clonar sob demanda =================
projetos_dir() { echo "${PROJETOS_DIR:-$([ -d /mnt/b ] && echo /mnt/b/projetos || echo "$H/projetos")}"; }
repos_url_limpa() { sed -E 's#https://[^@/]*@#https://#'; }
repos_catalogar() {  # $1 = arquivo do catalogo; resto = pastas a varrer
  local F="$1"; shift; local roots=("$@") r d n=0 novos=0
  if [ ${#roots[@]} -eq 0 ]; then
    for r in /mnt/c/Users/*/OneDrive*/Documentos/Projetos "$(projetos_dir)"; do [ -d "$r" ] && roots+=("$r"); done
  fi
  [ ${#roots[@]} -gt 0 ] || { echo "nenhuma pasta para varrer (passe uma: initio repos catalogar /caminho)"; return 1; }
  touch "$F"; local tmp; tmp=$(mktemp)
  for r in "${roots[@]}"; do
    say "varrendo $r"
    while IFS= read -r g; do
      d="${g%/.git}"; local url br ahead nome owner
      url=$(git -C "$d" remote get-url origin 2>/dev/null | repos_url_limpa)
      if [ -z "$url" ]; then echo "   sem remote (nao catalogado): $d"; continue; fi
      br=$(git -C "$d" symbolic-ref --short HEAD 2>/dev/null || echo main)
      ahead=$(git -C "$d" rev-list --count '@{u}..HEAD' 2>/dev/null || echo "?")
      nome=$(basename "$d")
      # mesmo nome com url diferente: prefixa o dono para nao colidir
      if awk -F'\t' -v n="$nome" -v u="$url" '$1==n && $2!=u{f=1} END{exit !f}' "$F" "$tmp" 2>/dev/null; then
        owner=$(echo "$url" | sed -E 's#.*[:/]([^/]+)/[^/]+$#\1#'); nome="$owner-$nome"; fi
      printf '%s\t%s\t%s\t%s\n' "$nome" "$url" "$br" "$d" >> "$tmp"
      n=$((n+1))
      if awk -F'\t' -v u="$url" '$2==u{f=1} END{exit !f}' "$F"; then echo "   ja catalogado: $nome ($br)"; else echo "   NOVO: $nome ($br)  $url"; novos=$((novos+1)); fi
      [ "$ahead" != 0 ] && [ "$ahead" != "?" ] && echo "         ATENCAO: $ahead commit(s) nao enviados em $nome - faca push antes de depender so do catalogo"
      [ "$ahead" = "?" ] && echo "         aviso: sem upstream configurado em $nome - confirme que o branch '$br' esta no GitHub"
    done < <(find "$r" -maxdepth 3 \( -name node_modules -o -name _QUARENTENA -o -name _da-wsl -o -name .venv -o -name venv \) -prune -o -name .git -type d -print 2>/dev/null | sort)
  done
  [ $DRY = 1 ] && { echo "[dry] $n repos achados, $novos novos; nada gravado"; rm -f "$tmp"; return 0; }
  # upsert por url (nunca remove); o ultimo achado vence
  { cat "$F" "$tmp"; } | awk -F'\t' 'NF>=3{ if(!($2 in seen)) order[++c]=$2; seen[$2]=$0 } END{for(i=1;i<=c;i++) print seen[order[i]]}' | sort > "$F.new" && mv "$F.new" "$F"; rm -f "$tmp"
  say "catalogo: $(wc -l < "$F") repos em $F ($novos novos). Publique com: initio sync"
}
repos_listar() {
  local F="$1" nome url br _ dest st; [ -s "$F" ] || { echo "catalogo vazio (initio repos catalogar)"; return 0; }
  printf '  %-26s %-9s %s\n' NOME STATUS URL
  while IFS=$'\t' read -r nome url br _; do dest="$(projetos_dir)/$nome"
    [ -d "$dest/.git" ] && st=clonado || st=falta; printf '  %-26s %-9s %s (%s)\n' "$nome" "$st" "$url" "$br"; done < "$F"
  echo "  destino dos clones: $(projetos_dir)"
}
repos_restaurar_locais() {  # $1=nome (do catalogo) $2=destino (clone)  - traz da _QUARENTENA os ARQUIVOS ignorados pelo git (.env, .dev.vars...). Nunca sobrescreve. Pastas (build/cache) so sao listadas.
  local nome="$1" dest="$2" F alt q src f n=0 dirs=() base; F="$(czsrc)/projetos-repos.tsv"
  base=$(awk -F'\t' -v n="$nome" '$1==n{k=split($4,a,"/"); print a[k]}' "$F" 2>/dev/null | head -1)
  src=""
  for q in "$(dirname "$(projetos_dir)")/_QUARENTENA" /mnt/c/Users/*/OneDrive*/_QUARENTENA; do
    for alt in "$nome" "$base"; do [ -n "$alt" ] || continue
      local c; while IFS= read -r c; do [ -d "$c/.git" ] && { src="$c"; break; }; done < <(ls -d "$q/$alt"__* 2>/dev/null | sort -r)
      [ -n "$src" ] && break
    done
    [ -n "$src" ] && break
  done
  [ -n "$src" ] && [ -d "$src/.git" ] || return 0
  say "   arquivos locais (ignorados pelo git) da quarentena: $src"
  while IFS= read -r f; do
    case "$f" in node_modules/|*/node_modules/) continue;; */) dirs+=("$f"); continue;; esac
    [ -e "$dest/$f" ] && continue
    [ $DRY = 1 ] && { say "      [dry] copiaria $f"; continue; }
    mkdir -p "$dest/$(dirname "$f")" && cp -p "$src/$f" "$dest/$f" && { say "      copiado: $f"; n=$((n+1)); }
  done < <(git -C "$src" -c core.quotepath=off status --porcelain --ignored 2>/dev/null | grep '^!!' | sed 's/^!! //')
  if [ ${#dirs[@]} -gt 0 ]; then
    local lib=0 d2 outras=(); for d2 in "${dirs[@]}"; do case "$d2" in */lib/|lib/|*/dist/|dist/) lib=$((lib+1));; *) outras+=("$d2");; esac; done
    [ ${#outras[@]} -gt 0 ] && say "      pastas ignoradas NAO copiadas (cache/estado local; ainda na quarentena): ${outras[*]:0:10}$([ ${#outras[@]} -gt 10 ] && echo " ... (+$(( ${#outras[@]} - 10 )))")"
    [ $lib -gt 0 ] && say "      + $lib pasta(s) de build (lib/ dist/) nao copiadas (regeneradas pelo build)"
  fi
  [ $n -gt 0 ] && say "      $n arquivo(s) local(is) restaurado(s)"
  return 0
}
repos_clonar() {  # $1 = catalogo; resto = nomes (vazio = todos os que faltam)
  local F="$1"; shift; local nome url br _ dest feitos=0 falhou=0 pulou=0
  [ -s "$F" ] || { echo "catalogo vazio (initio repos catalogar)"; return 1; }
  gh auth status >/dev/null 2>&1 || echo "aviso: gh nao autenticado; repos privados vao falhar (gh auth login)"
  mkdir -p "$(projetos_dir)"
  while IFS=$'\t' read -r nome url br _; do
    if [ $# -gt 0 ] && ! printf '%s\n' "$@" | grep -qx "$nome"; then continue; fi
    dest="$(projetos_dir)/$nome"
    [ -d "$dest/.git" ] && { say "   ja existe: $nome"; pulou=$((pulou+1)); repos_restaurar_locais "$nome" "$dest"; continue; }
    [ -e "$dest" ] && { say "   PULADO: $dest existe e nao e repo git"; falhou=$((falhou+1)); continue; }
    [ $DRY = 1 ] && { say "   [dry] clonaria $nome ($br) em $dest"; continue; }
    if GIT_TERMINAL_PROMPT=0 git clone -q --branch "$br" "$url" "$dest" 2>>"$LOG"; then say "   ok: $nome ($br)"; feitos=$((feitos+1)); repos_restaurar_locais "$nome" "$dest"
    else say "   FALHOU: $nome (sem permissao, repo removido ou branch '$br' inexistente?)"; falhou=$((falhou+1)); fi
  done < "$F"
  say "clonar: $feitos clonados, $pulou ja existiam, $falhou com problema (nunca faz push)"
  [ $falhou -eq 0 ]
}
repos_norm() { sed -E 's#^git@([^:]+):#\1/#; s#^(ssh|https?|git)://([^@/]*@)?##; s#\.git$##; s#/$##' | tr 'A-Z' 'a-z'; }
repos_duplicados() {  # [--profundo] [pasta...]  - SO LEITURA: acha o mesmo repo em varios lugares e diz qual esta mais atual
  local fundo=0 roots=() a r; for a in "$@"; do case "$a" in --profundo) fundo=1;; *) roots+=("$a");; esac; done
  if [ ${#roots[@]} -eq 0 ]; then
    for r in /mnt/c/Users/*/OneDrive*/Documentos/Projetos /mnt/c/Users/*/OneDrive*/Documentos/New\ project "$(projetos_dir)" "$H"; do [ -d "$r" ] && roots+=("$r"); done
  fi
  local tab; tab=$(mktemp); local g d url br head dt ahead
  say "procurando repos em ${#roots[@]} pasta(s)..."
  for r in "${roots[@]}"; do
    local md=4; [ "$r" = "$H" ] && md=5
    while IFS= read -r g; do
      d="${g%/.git}"; url=$(git -C "$d" remote get-url origin 2>/dev/null | repos_url_limpa | repos_norm); [ -n "$url" ] || continue
      br=$(git -C "$d" symbolic-ref --short HEAD 2>/dev/null || echo "-"); head=$(git -C "$d" rev-parse HEAD 2>/dev/null) || continue
      dt=$(git -C "$d" log -1 --format=%cd --date=short 2>/dev/null); ahead=$(git -C "$d" rev-list --count '@{u}..HEAD' 2>/dev/null || echo "?")
      printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$url" "$d" "$br" "$head" "$dt" "$ahead" >> "$tab"
    done < <(find "$r" -maxdepth $md \( -name node_modules -o -name _QUARENTENA -o -name .venv -o -name venv -o -name site-packages -o -name .cache -o -name .npm -o -name .nvm -o -name .cargo -o -name .rustup -o -name .sdkman -o -name .oh-my-zsh -o -name .goenv -o -name miniconda3 -o -name .local -o -name .config -o -name .bun -o -name .claude -o -name .codex \) -prune -o -name .git -type d -print 2>/dev/null)
  done
  sort -u -t$'\t' -k2,2 "$tab" -o "$tab"
  local urls; urls=$(cut -f1 "$tab" | sort | uniq -d)
  if [ -z "$urls" ]; then say "nenhum repo aparece em mais de um lugar (por URL do remote)."; else
    local u; while IFS= read -r u; do
      echo; echo "=== $u"; local members; members=$(awk -F'\t' -v u="$u" '$1==u' "$tab")
      # referencia = o HEAD que contem mais dos outros; empate: commit mais novo
      local best="" bestn=-1 bestdt="" bestok=0 p1 h1 d1 a1 n o ph okp
      while IFS=$'\t' read -r _ p1 _ h1 d1 a1; do n=0; okp=0; [ "$a1" = 0 ] && okp=1
        while IFS=$'\t' read -r _ o _ ph _; do git -C "$p1" merge-base --is-ancestor "$ph" "$h1" 2>/dev/null && n=$((n+1)); done <<< "$members"
        # mais heads contidos; empate: o que ja esta enviado ao GitHub; empate: commit mais novo
        if [ "$n" -gt "$bestn" ] || { [ "$n" -eq "$bestn" ] && { [ "$okp" -gt "$bestok" ] || { [ "$okp" -eq "$bestok" ] && [[ "$d1" > "$bestdt" ]]; }; }; }; then best="$p1"; bestn=$n; bestdt="$d1"; bestok=$okp; fi
      done <<< "$members"
      local bh; bh=$(awk -F'\t' -v p="$best" '$2==p{print $4}' "$tab")
      while IFS=$'\t' read -r _ p1 br h1 d1 ahead; do local rel
        if [ "$h1" = "$bh" ]; then rel="igual a referencia"
        elif git -C "$best" merge-base --is-ancestor "$h1" "$bh" 2>/dev/null; then rel="ATRAS da referencia em $(git -C "$best" rev-list --count "$h1..$bh") commit(s)"
        elif git -C "$p1" cat-file -e "$bh" 2>/dev/null; then rel="A FRENTE da referencia ($(git -C "$p1" rev-list --count "$bh..$h1") commit(s))"
        else rel="DIVERGENTE da referencia (tem commits proprios)"; fi
        [ "$p1" = "$best" ] && rel="REFERENCIA (mais atual)"
        local extra=""; [ "$ahead" != 0 ] && [ "$ahead" != "?" ] && extra=" | $ahead nao enviado(s) ao GitHub"; [ "$ahead" = "?" ] && extra=" | sem upstream"
        if [ $fundo = 1 ]; then local pend; pend=$(timeout 180 git -C "$p1" status --porcelain 2>/dev/null | wc -l); extra="$extra | $pend alteracao(oes) local(is)"; fi
        printf '  %-60s %-10s %s %s%s\n' "$p1" "$br" "${h1:0:7}" "$d1" ""; printf '      -> %s%s\n' "$rel" "$extra"
      done <<< "$members"
    done <<< "$urls"
  fi
  # copias sem .git (snapshots) com o mesmo nome de um repo conhecido
  echo; local nomes; nomes=$(awk -F'\t' '{n=split($2,a,"/"); print a[n]}' "$tab" | sort -u); local achou=0
  for r in "${roots[@]}"; do
    while IFS= read -r d; do [ -d "$d/.git" ] && continue
      echo "$nomes" | grep -qx "$(basename "$d")" || continue
      [ $achou = 0 ] && { echo "=== pastas SEM .git com nome de repo conhecido (provaveis copias/snapshots)"; achou=1; }
      echo "  $d"
      if [ $fundo = 1 ]; then local ref; ref=$(awk -F'\t' -v b="$(basename "$d")" '{n=split($2,a,"/"); if(a[n]==b){print $2; exit}}' "$tab")
        [ -n "$ref" ] && echo "      diferencas contra $ref: $(timeout 180 diff -rq --exclude=.git --exclude=node_modules "$d" "$ref" 2>/dev/null | wc -l) arquivo(s)"; fi
    done < <(find "$r" -maxdepth 2 -mindepth 1 -type d \( -name .git -o -name node_modules -o -name _QUARENTENA -o -name .local -o -name .config -o -name .cache \) -prune -o -type d -print 2>/dev/null)
  done
  [ $achou = 0 ] && echo "(nenhuma pasta sem .git com nome de repo conhecido)"
  rm -f "$tab"; echo; say "so leitura: nada foi alterado; usa o que cada copia ja sabe do GitHub (sem fetch). --profundo tambem conta alteracoes locais e compara copias sem git (pode demorar no OneDrive)."
}
repos_reparar() {  # [--eol] pasta...  - restaura arquivos versionados apagados (copia incompleta); --eol tambem descarta modificacoes que sao SO fim de linha (CRLF/LF)
  local eol=0 dirs=() a d n m lista; for a in "$@"; do case "$a" in --eol) eol=1;; *) dirs+=("${a%/}");; esac; done
  [ ${#dirs[@]} -gt 0 ] || { echo "uso: initio repos reparar [--eol] <pasta>..."; return 1; }
  for d in "${dirs[@]}"; do
    echo "=== $d"
    [ -d "$d/.git" ] || { say "   nao e repo git"; continue; }
    say "   [1/3] procurando arquivos apagados..."; n=$(git -C "$d" ls-files -d | wc -l); m=0; lista=$(mktemp)
    if [ $eol = 1 ]; then say "   [2/3] comparando conteudo ignorando fim de linha (OneDrive e lento: pode levar varios minutos, NAO esta travado)..."; repos_so_eol "$d" > "$lista"; m=$(grep -c . "$lista"); fi
    [ "$n" = 0 ] && [ "$m" = 0 ] && { say "   nada a reparar"; rm -f "$lista"; continue; }
    [ $DRY = 1 ] && { say "   [dry] restauraria $n apagado(s) e $m so-fim-de-linha"; rm -f "$lista"; continue; }
    say "   [3/3] restaurando: $n apagado(s), $m so-fim-de-linha..."
    [ "$n" -gt 0 ] && { git -C "$d" ls-files -z -d | xargs -0 git -C "$d" restore -- && say "   $n arquivo(s) apagado(s) restaurado(s)" || say "   FALHOU ao restaurar apagados"; }
    [ "$m" -gt 0 ] && { tr '\n' '\0' < "$lista" | xargs -0 git -C "$d" restore -- && say "   $m arquivo(s) so-fim-de-linha descartado(s) (conteudo identico)" || say "   FALHOU ao descartar fim de linha"; }
    rm -f "$lista"
  done
}
repos_so_eol() {  # $1=repo -> lista arquivos versionados modificados cuja unica diferenca e fim de linha (nao staged)
  local d="$1" real; real=$(git -C "$d" -c core.quotepath=off diff --ignore-cr-at-eol --numstat 2>/dev/null | cut -f3-)
  git -C "$d" -c core.quotepath=off diff --name-only 2>/dev/null | grep -vxF -f <(printf '%s\n' "$real" | sed '/^$/d' | { cat; echo "__nada__"; })
}
repos_quarentena_de() {  # $1 = pasta -> imprime a quarentena no MESMO volume (mv rapido, sem copiar entre discos)
  case "$1" in
    /mnt/c/Users/*/OneDrive*/*) echo "$(echo "$1" | sed -E 's#^(/mnt/c/Users/[^/]+/OneDrive[^/]*)/.*#\1#')/_QUARENTENA";;
    *) echo "$(dirname "$(projetos_dir)")/_QUARENTENA";;
  esac
}
repos_mover() {  # $1=origem $2=destino. mv; se o Windows negar (pastas somente-leitura), tira o atributo R (so metadado) e tenta de novo. Erro real fica em REPOS_MV_ERR
  REPOS_MV_ERR=$(mv -n "$1" "$2" 2>&1) && return 0
  if [ -d "$1" ] && command -v cmd.exe >/dev/null 2>&1 && case "$1" in /mnt/*) true;; *) false;; esac; then
    echo "   mv negado pelo Windows: removendo atributo somente-leitura das pastas (attrib -R, nao mexe em conteudo) e tentando de novo..."
    cmd.exe /c "attrib -R /S /D \"$(wslpath -w "$1")\\*\"" >/dev/null 2>&1
    REPOS_MV_ERR=$(mv -n "$1" "$2" 2>&1) && return 0
  fi
  return 1
}
repos_eliminar() {  # $1 = catalogo; [--aplicar] [--fetch] pasta...  - sem --aplicar so mostra o veredito. Nunca apaga: MOVE para _QUARENTENA
  local F="$1"; shift; local aplicar=0 fetch=0 okign=0 dirs=() a d
  for a in "$@"; do case "$a" in --aplicar) aplicar=1;; --fetch) fetch=1;; --ok-ignorados) okign=1;; *) dirs+=("${a%/}");; esac; done
  [ ${#dirs[@]} -gt 0 ] || { echo "uso: initio repos eliminar [--fetch] [--aplicar] [--ok-ignorados] <pasta>...   (sem --aplicar so mostra o que seria movido)"; return 1; }
  [ -s "$F" ] || { echo "catalogo vazio: rode 'initio repos catalogar' antes (so elimino copia cujo repo esta catalogado)"; return 1; }
  local ok=0 bloq=0
  for d in "${dirs[@]}"; do
    local motivos=() url urln br q nome
    echo "=== $d"
    if [ ! -d "$d/.git" ]; then echo "   BLOQUEADO: nao e repo git (snapshot/pasta comum): compare na mao, nao elimino"; bloq=$((bloq+1)); continue; fi
    url=$(git -C "$d" remote get-url origin 2>/dev/null | repos_url_limpa)
    [ -n "$url" ] || motivos+=("sem remote origin: nada garante que esta no GitHub")
    urln=$(printf '%s' "$url" | repos_norm)
    if [ -n "$url" ] && ! awk -F'\t' '{print $2}' "$F" | repos_norm | grep -qxF "$urln"; then motivos+=("repo nao esta no catalogo (initio repos catalogar)"); fi
    [ $fetch = 1 ] && [ -n "$url" ] && { say "   [1/3] fetch no GitHub..."; timeout 90 git -C "$d" fetch -q --all 2>/dev/null || motivos+=("fetch falhou (rede/credencial): nao da para confirmar o remoto"); }
    git -C "$d" rev-parse -q --verify '@{u}' >/dev/null 2>&1 || motivos+=("branch atual sem upstream")
    local ahead; ahead=$(git -C "$d" rev-list --count '@{u}..HEAD' 2>/dev/null || echo 0); [ "$ahead" = 0 ] || motivos+=("$ahead commit(s) nao enviados no branch atual")
    # commits em QUALQUER branch local que nao existem em nenhum remoto
    local b so=""; for b in $(git -C "$d" for-each-ref --format='%(refname:short)' refs/heads); do
      [ "$(git -C "$d" rev-list --count "$b" --not --remotes 2>/dev/null || echo 1)" = 0 ] || so="$so $b"; done
    [ -z "$so" ] || motivos+=("branch(es) com commits que nao estao em nenhum remoto:$so")
    [ -z "$(git -C "$d" stash list 2>/dev/null)" ] || motivos+=("ha stash guardado")
    git -C "$d" submodule status 2>/dev/null | grep -q . && motivos+=("tem submodulos (nao tratado)")
    say "   [2/3] conferindo alteracoes locais (git status; no OneDrive pode levar minutos, nao esta travado)..."
    local pend allst ign; allst=$(timeout 180 git -C "$d" -c core.quotepath=off status --porcelain --ignored 2>/dev/null); local rc=$?
    pend=$(printf '%s\n' "$allst" | grep -v '^!!' | sed '/^$/d')
    ign=$(printf '%s\n' "$allst" | grep '^!!' | grep -vE 'node_modules|\.venv|(^|/)venv/|/dist/|^!! dist/|(^|/)build/|\.cache|__pycache__|\.next/|\.nuxt/|coverage/|\.turbo|\.pytest_cache|\.mypy_cache|\.pnpm-store|\.parcel-cache|\.gradle|(^|/)target/' | sed '/^$/d')
    [ $rc = 124 ] && motivos+=("git status estourou o tempo (OneDrive lento): tente de novo")
    if [ -n "$pend" ]; then
      local nd nu nm neol nreal
      say "   [3/3] separando fim de linha de edicao real..."
      nd=$(printf '%s\n' "$pend" | grep -c '^ D'); nu=$(printf '%s\n' "$pend" | grep -c '^??')
      nm=$(printf '%s\n' "$pend" | grep -vc '^ D\|^??'); neol=$(repos_so_eol "$d" | grep -c .); nreal=$((nm-neol)); [ $nreal -lt 0 ] && nreal=0
      [ "$nd" -gt 0 ] && motivos+=("$nd arquivo(s) versionado(s) apagado(s) (copia incompleta?): rode 'initio repos reparar $d'")
      [ "$neol" -gt 0 ] && motivos+=("$neol arquivo(s) modificado(s) SO no fim de linha (CRLF/LF), conteudo identico: rode 'initio repos reparar --eol $d'")
      if [ "$nreal" -gt 0 ]; then motivos+=("$nreal arquivo(s) com EDICAO REAL nao commitada (git -C '$d' diff --ignore-cr-at-eol --stat):"); git -C "$d" -c core.quotepath=off diff --ignore-cr-at-eol --numstat 2>/dev/null | head -8 | awk -F'\t' '{printf "        +%s -%s %s\n",$1,$2,$3}'; fi
      if [ "$nu" -gt 0 ]; then motivos+=("$nu arquivo(s) NOVO(S) nao rastreado(s) (so existem aqui; commite ou ignore):"); git -C "$d" -c core.quotepath=off status --porcelain 2>/dev/null | grep '^??' | head -8 | sed 's/^/        /'; fi
    fi
    if [ -n "$ign" ] && [ $okign = 0 ]; then motivos+=("$(printf '%s\n' "$ign" | grep -c .) item(ns) IGNORADO(s) pelo .gitignore que so existem aqui (NAO estao no GitHub; ex.: .env, chaves, bancos). Copie/guarde o que importar e rode de novo com --ok-ignorados:"); printf '%s\n' "$ign" | head -12 | sed 's/^!! /        /'; fi
    if [ ${#motivos[@]} -gt 0 ]; then bloq=$((bloq+1)); local m; for m in "${motivos[@]}"; do echo "   BLOQUEADO: $m"; done; continue; fi
    br=$(git -C "$d" symbolic-ref --short HEAD 2>/dev/null || echo "-"); q=$(repos_quarentena_de "$d"); nome="$(basename "$d")__$(date +%Y%m%d-%H%M%S)"
    if [ $aplicar = 0 ]; then echo "   PODE ELIMINAR: tudo ja esta em $url ($br) -> moveria para $q/$nome   (confirme com --aplicar)"; ok=$((ok+1)); continue; fi
    mkdir -p "$q" && repos_mover "$d" "$q/$nome" && { echo "   MOVIDO para $q/$nome   (recupera: initio repos clonar ou mova de volta)"; ok=$((ok+1)); } || {
      echo "   FALHOU ao mover. Erro do sistema: ${REPOS_MV_ERR:-(vazio)}"
      echo "   Verificando se a origem continua inteira..."
      if [ -d "$d/.git" ] && [ ! -e "$q/$nome" ]; then echo "   origem intacta, nada foi movido. Causa provavel: arquivo aberto no Windows ou permissao (icacls/attrib); me mande o erro de: mv -n '$d' '$q/$nome'"
      else echo "   ATENCAO: estado parcial! origem .git: $([ -d "$d/.git" ] && echo ok || echo AUSENTE); destino existe: $([ -e "$q/$nome" ] && echo sim || echo nao). NAO apague nada: confira $d e $q/$nome"; fi
      bloq=$((bloq+1)); }
  done
  say "eliminar: $ok $([ $aplicar = 1 ] && echo movido\(s\) || echo elegivel\(is\)), $bloq bloqueado(s). Nada e apagado de vez: esvazie a quarentena voce mesmo quando quiser."
  [ $bloq -eq 0 ]
}
cmd_repos() {
  local sub="${1:-}"; shift || true; local F; F="$(czsrc)/projetos-repos.tsv"
  case "$sub" in
    catalogar) repos_catalogar "$F" "$@";;
    duplicados) repos_duplicados "$@";;
    listar) repos_listar "$F";;
    clonar) repos_clonar "$F" "$@";;
    reparar) repos_reparar "$@";;
    eliminar) repos_eliminar "$F" "$@";;
    *) echo "uso: initio repos catalogar [pasta...] | duplicados [--profundo] | listar | clonar [nome...] | reparar [--eol] <pasta>... | eliminar [--fetch] [--aplicar] <pasta>...   (destino: $(projetos_dir); mude com PROJETOS_DIR)";;
  esac
}

ajuda() { cat <<'EOT'
initio restore [cofre] [chave]     maquina nova: cofre + chave + dotfiles + repos
initio <perfil>... | all | bootstrap   instala perfis (base sempre primeiro); initio list mostra
initio sync [--upgrade] [--dry] [-q]    captura esta maquina, publica nos dotfiles, puxa, aplica e instala o que falta
initio snapshot [--dry]            so a captura (configs + dependencias novas -> extras.conf)
initio cofre salvar|publicar|abrir segredos em arquivo age; publicar = release no repo privado do cofre
initio publicar-boot               espelha initio+perfis+install.sh no repo publico de bootstrap
initio ssh-github                  cadastra/usa chave SSH no GitHub (cria uma com passphrase se preciso)
initio doctor                      diagnostico
initio perfil add <perfil> <apt|npm|pip|cargo|pipx> <pacote>
initio repos catalogar [pasta...] registra url+branch dos repos achados (OneDrive\Projetos e B:\projetos por padrao)
initio repos duplicados [--profundo]  acha o mesmo repo em varios lugares e diz qual esta mais atual (so leitura)
initio repos reparar [--eol] <pasta>... restaura apagados (copia incompleta); --eol descarta modificacoes so de fim de linha
initio repos eliminar [--aplicar] <pasta>...  confere se tudo esta no GitHub e MOVE a copia p/ _QUARENTENA (sem --aplicar so mostra)
initio arquivos duplicados [--min-kb N] [--tudo] [raiz...]  acha arquivos de conteudo identico (sha256) entre B:, D: e OneDrive; so leitura
initio repos listar | clonar [nome...]   mostra o catalogo | clona so o que falta em B:\projetos (nunca faz push)
EOT
}

# ================= arquivos duplicados (mesmo conteudo, sha256) entre B:, D: e OneDrive =================
arquivos_duplicados() {  # so leitura; nada e movido nem apagado
  local MIN=4 BAIXAR=0 TUDO=0 roots=() r
  while [ $# -gt 0 ]; do case "$1" in
    --min-kb) MIN="${2:-4}"; shift 2;;
    --baixar) BAIXAR=1; shift;;
    --tudo) TUDO=1; shift;;
    *) roots+=("$1"); shift;; esac; done
  if [ ${#roots[@]} -eq 0 ]; then
    for r in /mnt/b /mnt/d /mnt/c/Users/*/OneDrive*; do [ -d "$r" ] || continue; case "$r" in /mnt/c/*) [ -d "$r/Documentos" ] || [ -d "$r/Documents" ] || continue;; esac; roots+=("$r"); done
  fi
  [ ${#roots[@]} -gt 0 ] || { echo "nenhuma raiz (passe pastas: initio arquivos duplicados /mnt/b /mnt/d ...)"; return 1; }
  local W OUT; W=$(mktemp -d); OUT="$H/duplicados-arquivos-$(date +%F).txt"
  local ex=( -name node_modules -o -name .git -o -name .pnpm-store -o -name '$RECYCLE.BIN' -o -name 'System Volume Information' -o -name .venv -o -name venv -o -name __pycache__ -o -name .cache -o -name .npm )
  [ $TUDO = 0 ] && ex+=( -o -name _QUARENTENA -o -name VHD -o -name WSL-backups )
  say "1/4 listando arquivos >= ${MIN} KB em: ${roots[*]} (em disco grande/OneDrive leva minutos; nao esta travado)"
  [ $TUDO = 0 ] && echo "   ignorando: node_modules .git .pnpm-store .venv caches _QUARENTENA VHD WSL-backups (use --tudo para incluir)"
  find "${roots[@]}" \( "${ex[@]}" \) -prune -o -type f -size +"${MIN}"k -printf '%s\t%b\t%p\n' 2>/dev/null > "$W/todos"
  local total skip=0; total=$(wc -l < "$W/todos")
  # arquivo so-na-nuvem (OneDrive) tem tamanho > 0 e 0 blocos alocados: ler dispararia download
  if [ $BAIXAR = 0 ]; then
    skip=$(awk -F'\t' '$1>0 && $2==0' "$W/todos" | wc -l)
    awk -F'\t' '!($1>0 && $2==0)' "$W/todos" > "$W/locais"; mv "$W/locais" "$W/todos"
  fi
  echo "   $total arquivos; $skip so na nuvem/esparsos nao lidos (para incluir, baixe-os ou use --baixar)"
  if [ "$total" -gt 0 ] && [ "$skip" -gt $((total/2)) ]; then echo "   AVISO: mais da metade parece 'so nuvem'. A heuristica pode nao valer neste disco; rode com --baixar se tiver certeza do espaco."; fi
  awk -F'\t' '{print $1"\t"$3}' "$W/todos" > "$W/sp"
  say "2/4 agrupando por tamanho"
  awk -F'\t' 'NR==FNR{n[$1]++;next} n[$1]>1' "$W/sp" "$W/sp" > "$W/c1"
  echo "   $(wc -l < "$W/c1") candidatos (mesmo tamanho que algum outro)"
  say "3/4 comparando o inicio (1 MB) de cada candidato"
  cut -f2 "$W/c1" | xargs -r -d '\n' -P4 -n1 sh -c 'head -c 1 -- "$1" >/dev/null 2>&1 || { printf "ERRO\t%s\n" "$1"; exit 0; }; h=$(head -c 1048576 -- "$1" 2>/dev/null | sha256sum | cut -c1-64); printf "%s\t%s\n" "$h" "$1"' _ > "$W/h1"
  awk -F'\t' '$1=="ERRO"' "$W/h1" > "$W/err"; awk -F'\t' '$1!="ERRO"' "$W/h1" > "$W/h1ok"
  awk -F'\t' 'NR==FNR{s[$2]=$1;next}{print s[$2]"|"$1"\t"$2}' "$W/c1" "$W/h1ok" > "$W/k1"
  awk -F'\t' 'NR==FNR{n[$1]++;next} n[$1]>1' "$W/k1" "$W/k1" > "$W/c2"
  echo "   $(wc -l < "$W/c2") candidatos apos o inicio"
  say "4/4 hash completo (sha256) dos que sobraram"
  cut -f2 "$W/c2" | xargs -r -d '\n' -P4 -n1 sh -c 'h=$(sha256sum < "$1" 2>/dev/null | cut -c1-64); [ -n "$h" ] || h=ERRO; printf "%s\t%s\n" "$h" "$1"' _ > "$W/h2"
  # junta tamanho (do c1) com hash completo e agrupa
  awk -F'\t' '$1=="ERRO"' "$W/h2" >> "$W/err"; awk -F'\t' '$1!="ERRO"' "$W/h2" > "$W/h2ok"
  awk -F'\t' 'NR==FNR{sz[$2]=$1;next}{print sz[$2]"\t"$1"\t"$2}' "$W/c1" "$W/h2ok" > "$W/final"
  echo "   diagnostico: passo 3 -> $(wc -l < "$W/c2") arquivos ($(awk -F'\t' '{split($1,a,"|"); if(a[1]>1048576)n++}END{print n+0}' "$W/c2") maiores que 1 MB); passo 4 -> $(wc -l < "$W/h2ok") lidos, $(cut -f1 "$W/h2ok" | sort -u | wc -l) conteudos distintos, $(awk -F'\t' '{print $1}' "$W/h2ok" | sort | uniq -d | wc -l) hashes repetidos"
  local rl; rl=$(printf '%s\n' "${roots[@]}" | paste -sd'|')
  awk -F'\t' -v roots="$rl" '
    function hum(b){ if(b>=1073741824) return sprintf("%.2f GB",b/1073741824); if(b>=1048576) return sprintf("%.1f MB",b/1048576); return sprintf("%.0f KB",b/1024) }
    function root(p,  i){ for(i=1;i<=nr;i++) if(index(p,R[i])==1) return R[i]; return "?" }
    BEGIN{nr=split(roots,R,"|")}
    $2!="" {k=$1"\t"$2; n[k]++; L[k]=L[k] "\001  " $3; sz[k]=$1; RX[k]=RX[k] "|" root($3)}
    END{
      for(k in n) if(n[k]>1){ w=sz[k]*(n[k]-1); g++; tot+=w
        split(RX[k],a,"|"); cross=0; for(i=3;i<=length(a);i++) if(a[i]!=a[2]) cross=1
        if(cross) cx++; else sx++
        printf "%020d\t%d copias x %s = %s desperdicio%s%s\n", w, n[k], hum(sz[k]), hum(w), (cross?"  [entre discos/pastas raiz]":"  [mesma raiz]"), L[k] }
      printf "TOTAL\t%d\t%d\t%d\t%d\n", g, tot, cx, sx > "/dev/stderr" }' "$W/final" 2> "$W/resumo" | sort -r | cut -f2- | tr '\001' '\n' > "$W/grupos"
  if grep -qi "awk:\|fatal\|error" "$W/resumo" 2>/dev/null; then echo "ERRO INTERNO no agrupamento (nada confiavel):"; head -3 "$W/resumo"; rm -rf "$W"; return 1; fi
  local g tot cx sx; IFS=$'\t' read -r _ g tot cx sx < "$W/resumo"
  g=${g:-0}; tot=${tot:-0}
  { echo "# duplicados de conteudo (sha256) - $(date '+%F %T')"; echo "# raizes: ${roots[*]}"; echo "# $g grupos; desperdicio total $(awk -v b="$tot" 'BEGIN{printf "%.2f GB", b/1073741824}')"; echo; cat "$W/grupos"; } > "$OUT"
  echo
  if [ "$g" = 0 ]; then echo "NENHUM arquivo duplicado (>= ${MIN} KB, conteudo identico) entre as raizes lidas."
  else echo "$g grupo(s) de arquivos IDENTICOS; desperdicio total $(awk -v b="$tot" 'BEGIN{printf "%.2f GB", b/1073741824}') (${cx:-0} entre raizes/pastas, ${sx:-0} na mesma raiz)"; echo "Maiores:"; head -n 40 "$W/grupos"; fi
  local nerr; nerr=$(wc -l < "$W/err" 2>/dev/null || echo 0)
  if [ "${nerr:-0}" -gt 0 ]; then echo; echo "ATENCAO: $nerr arquivo(s) candidato(s) NAO puderam ser lidos (permissao/bloqueio) e ficaram SEM verificar. Exemplos:"; cut -f2 "$W/err" | head -8 | sed 's/^/   /'; { echo; echo "# ilegiveis (sem verificar):"; cut -f2 "$W/err"; } >> "$OUT"; fi
  echo; echo "relatorio completo: $OUT"
  echo "limites: so conteudo byte-a-byte identico; versoes diferentes do mesmo arquivo, pastas parecidas e os $skip arquivos so-nuvem NAO entram. Nada foi movido ou apagado."
  rm -rf "$W"
}

# ================= entrada =================
VERBOSE=1; [ -t 1 ] || VERBOSE=0
ARGS=(); for a in "$@"; do case "$a" in --dry) DRY=1;; --upgrade) UPGRADE=1;; -q|--quiet) VERBOSE=0;; -v|--verbose) VERBOSE=1;; *) ARGS+=("$a");; esac; done
# verbose (padrao em terminal): mostra ao vivo o que vai para o log (apt, npm, cargo...); -q silencia
if [ "$VERBOSE" = 1 ] && [ "$DRY" = 0 ]; then
  : >> "$LOG"; tail -n0 -F "$LOG" 2>/dev/null | sed -u 's/^/      | /' &
  TAILPID=$!; trap 'kill $TAILPID 2>/dev/null' EXIT
fi
set -- "${ARGS[@]:-ajuda}"; cmd="$1"; shift || true
PERFIS=()
case "$cmd" in
  ajuda|help|-h|--help) ajuda;;
  list) for f in "$INITIO_HOME"/perfis/*.conf; do b=$(basename "$f" .conf); ( DESC=""; . "$f"; printf '  %-12s %s\n' "$b" "$DESC" ); done;;
  restore) cmd_restore "$@";;
  publicar-boot) cmd_publicar_boot;;
  sync) cmd_sync;;
  snapshot) cmd_snapshot;;
  cofre) cmd_cofre "$@";;
  ssh-github) cmd_sshgh;;
  portar) cmd_portar;;
  doctor) cmd_doctor;;
  perfil) cmd_perfil "$@";;
  repos) cmd_repos "$@";;
  arquivos) case "${1:-}" in duplicados) shift; arquivos_duplicados "$@";; *) echo "uso: initio arquivos duplicados [--min-kb N] [--baixar] [--tudo] [raiz...]";; esac;;
  all) for f in "$INITIO_HOME"/perfis/*.conf; do [ "$(basename "$f" .conf)" = extras ] || PERFIS+=("$(basename "$f" .conf)"); done; instalar_lista;;
  bootstrap) PERFIS=(base); instalar_lista;;
  *) PERFIS=("$cmd" "$@"); instalar_lista;;
esac
